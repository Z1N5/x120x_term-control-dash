[Unit]
Description=X120X UPS monitor and opt-in controller
After=local-fs.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=notify
ExecStart=/usr/bin/python3 /usr/local/bin/x120x_upsd.py
RuntimeDirectory=x120x-ups
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=x120x-ups
StateDirectoryMode=0700
WatchdogSec=45
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0022

[Install]
WantedBy=multi-user.target
